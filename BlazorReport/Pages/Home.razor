@page "/"
@inject EmployeeService EmployeeService
@inject ExcelExportService ExcelExportService
@inject IJSRuntime JSRuntime

<PageTitle>@PageTitle</PageTitle>

<div class="container-fluid mt-4">
    <h2 class="mb-4">@PageTitle</h2>

    <div class="mb-3">
        <Button Color="Color.Success" Icon="fa-solid fa-file-excel" OnClick="ExportToExcel" class="me-2">
            @LabelExportToExcel
        </Button>
        <Button Color="Color.Danger" Icon="fa-solid fa-file-pdf" OnClick="ExportToPdf">
            @LabelExportToPdf
        </Button>
    </div>

    @if (employees == null)
    {
        <p><em>@MessageDataReading</em></p>
    }
    else if (employees.Count == 0)
    {
        <p><em>@MessageDataNotFound</em></p>
    }
    else
    {
        <Table TItem="Employee" Items="@employees" IsBordered="true" IsStriped="true" AutoGenerateColumns="false">
            <TableColumns>
                <TableColumn @bind-Field="@context.EmployeeNumber" Text=@HeaderEmployeeNumber Sortable="true" />
                <TableColumn @bind-Field="@context.Name" Text=@HeaderName Sortable="true" />
                <TableColumn @bind-Field="@context.Department" Text=@HeaderDepartment Sortable="true" />
                <TableColumn @bind-Field="@context.Post" Text=@HeaderPost Sortable="true" />
                <TableColumn @bind-Field="@context.DateOfJoining" Text=@HeaderDateOfJoining Sortable="true" />
            </TableColumns>
        </Table>
    }
</div>

@code {
    private readonly string PageTitle = "社員情報管理";
    private readonly string HeaderEmployeeNumber = "社員番号";
    private readonly string HeaderName = "氏名";
    private readonly string HeaderDepartment = "所属";
    private readonly string HeaderPost = "役職";
    private readonly string HeaderDateOfJoining = "入社年月日";
    private readonly string LabelExportToExcel = "Excelエクスポート";
    private readonly string LabelExportToPdf = "PDFエクスポート";
    private readonly string MessageDataReading = "データを読み込んでいます...";
    private readonly string MessageDataNotFound = "データがありません。";
    // 社員データリスト
    private List<Employee>? employees;

    /// <summary>
    /// 初期化時に社員データを読み込む
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        employees = await EmployeeService.GetEmployeesAsync();
    }

    /// <summary>
    /// Excelファイルにエクスポート
    /// </summary>
    private async Task ExportToExcel()
    {
        if (employees == null || employees.Count == 0)
        {
            return;
        }

        try
        {
            // Excelファイルを生成
            var excelBytes = ExcelExportService.ExportToExcel(employees);

            // JavaScriptを呼び出してダウンロード
            var fileName = $"社員情報_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
            await JSRuntime.InvokeVoidAsync(
            "fileDownloadFunctions.downloadFile",
            fileName,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            excelBytes
            );
        }
        catch (Exception ex)
        {
            System.Console.WriteLine($"Excel export error: {ex.Message}");
        }
    }

    /// <summary>
    /// PDFファイルにエクスポート
    /// </summary>
    private async Task ExportToPdf()
    {
        if (employees == null || employees.Count == 0)
        {
            return;
        }

        try
        {
            // JavaScriptに渡すために匿名オブジェクトの配列に変換
            // プロパティ名を明示的にcamelCaseで指定
            var employeeData = employees.Select(e => new
            {
                employeeNumber = e.EmployeeNumber,
                name = e.Name,
                department = e.Department,
                post = e.Post,
                dateOfJoining = e.DateOfJoining
            }).ToArray();

            System.Console.WriteLine($"Exporting {employeeData.Length} employees to PDF");

            // JavaScriptを呼び出してPDFを生成・ダウンロード
            // Canvas版を使用（日本語対応）
            var fileName = $"社員情報_{DateTime.Now:yyyyMMdd_HHmmss}.pdf";
            await JSRuntime.InvokeVoidAsync(
            "pdfExportFunctions.exportToPdfCanvas",
            employeeData,
            fileName
            );
        }
        catch (Exception ex)
        {
            System.Console.WriteLine($"PDF export error: {ex.Message}");
        }
    }
}
